generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  NUTRI
  PATIENT
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  password         String
  role             UserRole
  createdAt        DateTime         @default(now())
  patientProfile   PatientProfile?  @relation("PatientUserProfile")
  assignedPatients PatientProfile[] @relation("NutritionistPatients")
  macroGoal        MacroGoal?       @relation("PatientMacroGoal")
  dailyMacroLogs   DailyMacroLog[]  @relation("PatientDailyMacroLogs")
}

model PatientProfile {
  id             String @id @default(cuid())
  userId         String @unique
  nutritionistId String
  user           User   @relation("PatientUserProfile", fields: [userId], references: [id], onDelete: Cascade)
  nutritionist   User   @relation("NutritionistPatients", fields: [nutritionistId], references: [id], onDelete: Restrict)
}

model MacroGoal {
  id        String @id @default(cuid())
  patientId String @unique
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  patient   User   @relation("PatientMacroGoal", fields: [patientId], references: [id], onDelete: Cascade)
}

model DailyMacroLog {
  id               String   @id @default(cuid())
  patientId        String
  date             DateTime @db.Date
  caloriesConsumed Int
  proteinConsumed  Int
  carbsConsumed    Int
  fatConsumed      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patient          User     @relation("PatientDailyMacroLogs", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, date])
}
