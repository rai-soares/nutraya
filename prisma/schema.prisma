generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  NUTRI
  PATIENT
}

enum MessageType {
  TEXT
  IMAGE
}

model User {
  id                      String           @id @default(cuid())
  name                    String
  email                   String           @unique
  password                String
  role                    UserRole
  createdAt               DateTime         @default(now())
  patientProfile          PatientProfile?  @relation("PatientUserProfile")
  assignedPatients        PatientProfile[] @relation("NutritionistPatients")
  macroGoal               MacroGoal?       @relation("PatientMacroGoal")
  dailyMacroLogs          DailyMacroLog[]  @relation("PatientDailyMacroLogs")
  mealPlansAsPatient      MealPlan[]       @relation("PatientMealPlans")
  mealPlansAsNutritionist MealPlan[]       @relation("NutritionistMealPlans")
  mealCompletions         MealCompletion[] @relation("PatientMealCompletions")
  patientConversations    Conversation[]   @relation("PatientConversations")
  nutritionistConversations Conversation[] @relation("NutritionistConversations")
  sentMessages            Message[]        @relation("SentMessages")
  receivedMessages        Message[]        @relation("ReceivedMessages")
}

model PatientProfile {
  id             String @id @default(cuid())
  userId         String @unique
  nutritionistId String
  user           User   @relation("PatientUserProfile", fields: [userId], references: [id], onDelete: Cascade)
  nutritionist   User   @relation("NutritionistPatients", fields: [nutritionistId], references: [id], onDelete: Restrict)
}

model MacroGoal {
  id        String @id @default(cuid())
  patientId String @unique
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  patient   User   @relation("PatientMacroGoal", fields: [patientId], references: [id], onDelete: Cascade)
}

model DailyMacroLog {
  id               String   @id @default(cuid())
  patientId        String
  date             DateTime @db.Date
  caloriesConsumed Int
  proteinConsumed  Int
  carbsConsumed    Int
  fatConsumed      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patient          User     @relation("PatientDailyMacroLogs", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, date])
}

model MealPlan {
  id             String   @id @default(cuid())
  patientId      String
  nutritionistId String
  title          String
  description    String?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patient        User     @relation("PatientMealPlans", fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist   User     @relation("NutritionistMealPlans", fields: [nutritionistId], references: [id], onDelete: Restrict)
  meals          Meal[]

  @@index([patientId])
  @@index([nutritionistId])
}

model Meal {
  id            String   @id @default(cuid())
  mealPlanId    String
  name          String
  description   String?
  scheduledTime String?
  order         Int
  calories      Int
  protein       Int
  carbs         Int
  fat           Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  completions   MealCompletion[]

  @@index([mealPlanId])
  @@index([mealPlanId, order])
}

model MealCompletion {
  id          String   @id @default(cuid())
  patientId   String
  mealId      String
  date        DateTime @db.Date
  completedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     User     @relation("PatientMealCompletions", fields: [patientId], references: [id], onDelete: Cascade)
  meal        Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([patientId, mealId, date])
  @@index([patientId, date])
  @@index([mealId])
}

model Conversation {
  id              String    @id @default(cuid())
  patientId       String
  nutritionistId  String
  lastMessageText String?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  patient         User      @relation("PatientConversations", fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist    User      @relation("NutritionistConversations", fields: [nutritionistId], references: [id], onDelete: Restrict)
  messages        Message[]

  @@unique([patientId, nutritionistId])
  @@index([patientId])
  @@index([nutritionistId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  receiverId     String
  messageType    MessageType
  text           String?
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([receiverId, readAt])
}
